{
  "cli": {
    "version": ">= 7.3.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_STRAPI_URL_BASE": "https://apiv4.webe.radio",
        "EXPO_PUBLIC_DEFAULT_PAGE_SIZE": "50",
        "EXPO_PUBLIC_COVER_SERVER_URL": "https://cover.webe.radio",
        "EXPO_PUBLIC_STRAPI_API_TOKEN": "your-token-here"
      },
      "android": {
        "image": "latest",
        "autoIncrement": "versionCode",
        "env": {
          "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
        }
      }
    },
    "preview": {
      "distribution": "internal",
      "android": {
        "image": "latest",
        "autoIncrement": "versionCode",
        "env": {
          "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
        }
      }
    },
    "production": {
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_STRAPI_URL_BASE": "https://apiv4.webe.radio",
        "EXPO_PUBLIC_DEFAULT_PAGE_SIZE": "50",
        "EXPO_PUBLIC_COVER_SERVER_URL": "https://cover.webe.radio",
        "EXPO_PUBLIC_STRAPI_API_TOKEN": "your-token-here"
      },
      "android": {
        "image": "latest",
        "buildType": "app-bundle",
        "gradleCommand": ":app:bundleRelease",
        "autoIncrement": "versionCode",
        "env": {
          "ANDROID_SUPPORT_FLEXIBLE_PAGE_SIZES": "ON"
        }
      },
      "ios": {
        "image": "latest"
      }
    }
  },
  "submit": {
    "production": {}
  }
}