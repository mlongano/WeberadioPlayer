{
  "expo": {
    "name": "WeBeRadioApp",
    "slug": "webe-radio-app",
    "version": "5.0.3",
    "orientation": "portrait",
    "icon": "./app/assets/logo.png",
    "scheme": "webe",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./app/assets/logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "radio.webe.app",
      "buildNumber": "2.0.2"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./app/assets/logo.png",
        "backgroundColor": "#ffffff"
      },
      "package": "radio.webe.app",
      "versionCode": 11
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./app/assets/logo.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": false,
            "proguardMinifyEnabled": false,
            "packagingOptions": {
              "pickFirst": [
                "**/libc++_shared.so",
                "**/libjsc.so"
              ]
            },
            "compileSdkVersion": 35,
            "targetSdkVersion": 35,
            "buildToolsVersion": "35.0.0",
            "supportLargeHeap": true,
            "enableSeparateBuildPerCPUArchitecture": false,
            "universalApk": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "32102b06-aef8-43cc-b8b9-e178583b3274"
      },
      "router": {
        "origin": false
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/32102b06-aef8-43cc-b8b9-e178583b3274"
    },
    "owner": "webmaster-ittmarconi"
  }
}